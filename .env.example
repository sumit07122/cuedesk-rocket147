# Firebase web app configuration. Copy this file to .env and use values from
# Firebase Console → Project settings → Your apps → Web app.
# These client settings are included in the browser build; never put service
# account credentials, private keys, or other server secrets in VITE_ variables.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-sender-id

# Optional when using a named Firestore database. Leave unset for (default).
# VITE_FIREBASE_DATABASE_ID=(default)

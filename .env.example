# =====================================================================
# CueDesk — Rocket 147 Snooker & Pool Club Management System
# Production Environment Variables Configuration (.env.example)
# =====================================================================

# ---------------------------------------------------------------------
# Firebase Client Configuration (Required)
# Retrieve these credentials from your Firebase Console -> Project Settings
# ---------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=rocket147-cuedesk.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rocket147-cuedesk
VITE_FIREBASE_STORAGE_BUCKET=rocket147-cuedesk.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ---------------------------------------------------------------------
# Email Notifications & Service Integrations (Optional)
# ---------------------------------------------------------------------
RESEND_API_KEY=re_123456789_your_resend_api_key
UPLOADTHING_SECRET=sk_live_your_uploadthing_secret
UPLOADTHING_APP_ID=your_uploadthing_app_id
DATABASE_URL=postgresql://user:password@localhost:5432/cuedesk

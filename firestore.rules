rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function userProfile() {
      return get(userPath(request.auth.uid)).data;
    }

    function activeStaff(clubId) {
      return hasUserProfile()
        && userProfile().clubId == clubId
        && userProfile().status == 'active'
        && userProfile().role in ['owner', 'manager', 'worker'];
    }

    function owner(clubId) {
      return activeStaff(clubId) && userProfile().role == 'owner';
    }

    function managerOrOwner(clubId) {
      return activeStaff(clubId) && userProfile().role in ['owner', 'manager'];
    }

    function customerOwns(clubId, customerId) {
      return hasUserProfile()
        && request.auth.token.email_verified == true
        && userProfile().clubId == clubId
        && userProfile().role == 'customer'
        && userProfile().status == 'active'
        && userProfile().customerId == customerId
        && exists(/databases/$(database)/documents/clubs/$(clubId)/customerPortal/$(customerId))
        && get(/databases/$(database)/documents/clubs/$(clubId)/customerPortal/$(customerId)).data.enabled == true;
    }

    function validStaffInvite(uid) {
      let profile = request.resource.data;
      let invitePath = /databases/$(database)/documents/invitations/$(profile.email);
      let inviteBefore = get(invitePath);
      let inviteAfter = getAfter(invitePath);
      return profile.email == request.auth.token.email
        && profile.status == 'active'
        && profile.role in ['manager', 'worker']
        && exists(invitePath)
        && inviteBefore.data.email == profile.email
        && inviteBefore.data.status == 'pending'
        && inviteBefore.data.code == profile.invitationCode
        && inviteBefore.data.role == profile.role
        && inviteBefore.data.clubId == profile.clubId
        && inviteAfter.data.status == 'accepted'
        && inviteAfter.data.acceptedByUid == uid;
    }

    function validCustomerAccount(uid) {
      let profile = request.resource.data;
      let accessPath = /databases/$(database)/documents/clubs/$(profile.clubId)/customerAccess/$(profile.email);
      return uid == request.auth.uid
        && request.auth.token.email_verified == true
        && profile.email == request.auth.token.email
        && profile.role == 'customer'
        && profile.status == 'active'
        && exists(accessPath)
        && get(accessPath).data.enabled == true
        && get(accessPath).data.customerId == profile.customerId
        && get(accessPath).data.clubId == profile.clubId;
    }

    function validCheckoutSession(session, record, config) {
      let sessionEnd = session.isPaused == true && session.pausedAt is number ? session.pausedAt : record.endTime;
      let pausedSeconds = session.totalPausedSeconds is number ? session.totalPausedSeconds : 0;
      let minimumMinutes = config.minimumChargeMinutes is number ? config.minimumChargeMinutes : 0;
      let elapsed = math.max(0, math.floor((sessionEnd - session.startTime) / 1000) - pausedSeconds);
      let billableMinutes = elapsed > 0 ? math.max(math.ceil(elapsed / 60), minimumMinutes) : 0;
      let expectedFee = billableMinutes * session.hourlyRate / 60;
      return record.startTime == session.startTime
        && record.hourlyRate == session.hourlyRate
        && record.durationSeconds == elapsed
        && record.tableFee == expectedFee;
    }

    function validCheckoutTotals(record, config) {
      let subtotal = record.tableFee + record.foodFee + record.extraFee;
      let discount = record.discountAmount;
      let rawTotal = math.max(0, subtotal - discount);
      let roundingRule = config.roundingRule is string ? config.roundingRule : 'nearest_1';
      let expectedTotal = roundingRule == 'nearest_1' ? math.round(rawTotal)
        : roundingRule == 'nearest_5' ? math.round(rawTotal / 5) * 5
        : roundingRule == 'round_up' ? math.ceil(rawTotal)
        : math.round(rawTotal * 100) / 100;
      let discountPercent = config.maxCashierDiscountPercent is number ? config.maxCashierDiscountPercent : 0;
      let discountLimit = subtotal * discountPercent / 100;
      return record.tableFee is number && record.tableFee >= 0
        && record.foodFee is number && record.foodFee >= 0
        && record.extraFee is number && record.extraFee >= 0
        && record.taxAmount == 0
        && discount is number && discount >= 0 && discount <= subtotal
        && (userProfile().role != 'worker' || discount <= discountLimit)
        && record.grandTotal == expectedTotal
        && record.amountPaid is number && record.amountPaid >= 0
        && record.balanceDue is number && record.balanceDue >= 0
        && record.amountPaid + record.balanceDue == record.grandTotal;
    }

    function validWorkerCheckout(record, session) {
      let sessionFoodTotal = session.get('foodTotal', null);
      let sessionFoodOrders = session.get('foodOrders', []);
      let splitData = record.get('splitBreakdown', {});
      let splitType = splitData is map ? splitData.get('splitType', 'method') : 'method';
      return (sessionFoodTotal is number && record.foodFee == sessionFoodTotal
          || sessionFoodTotal == null && sessionFoodOrders is list
            && sessionFoodOrders.size() == 0 && record.foodFee == 0)
        && record.customerIds is list
        && record.customerIds.size() <= 1
        && (record.customerIds.size() == 0 || record.customerIds[0] == record.customerId)
        && splitType != 'players'
        && record.extraFee == 0
        && record.discountAmount == 0
        && record.foodOrders == session.get('foodOrders', []);
    }

    function validCheckout(clubId) {
      let tableId = request.resource.data.get('tableId', '_invalid');
      let tablePath = /databases/$(database)/documents/clubs/$(clubId)/tables/$(tableId);
      let beforeTable = get(tablePath).data;
      let afterTable = getAfter(tablePath).data;
      let session = beforeTable.currentSession;
      let config = get(/databases/$(database)/documents/clubs/$(clubId)/config/settings).data;
      return activeStaff(clubId)
        && request.resource.data.processedBy == request.auth.token.email
        && tableId is string
        && exists(tablePath)
        && beforeTable.status in ['occupied', 'payment_pending']
        && session != null
        && afterTable.status == 'available'
        && afterTable.currentSession == null
        && request.resource.data.tableName == beforeTable.name
        && afterTable.lastReceiptId == request.resource.data.id
        && validCheckoutSession(session, request.resource.data, config)
        && request.resource.data.endTime <= request.time.toMillis() + 60000
        && request.resource.data.endTime >= request.time.toMillis() - 120000
        && validCheckoutTotals(request.resource.data, config)
        && (userProfile().role != 'worker' || validWorkerCheckout(request.resource.data, session))
        && request.resource.data.processedBy is string;
    }

    function validWorkerFoodOrder(clubId, previousSession, nextSession) {
      let oldOrders = previousSession.get('foodOrders', []);
      let nextOrders = nextSession.get('foodOrders', []);
      let newOrder = nextOrders is list && nextOrders.size() > 0
        ? nextOrders[nextOrders.size() - 1]
        : {};
      let menuId = newOrder is map ? newOrder.get('menuId', '_invalid') : '_invalid';
      let menuPath = /databases/$(database)/documents/clubs/$(clubId)/menuItems/$(menuId);
      let menu = get(menuPath).data;
      return oldOrders is list
        && nextOrders is list
        && nextOrders.size() == oldOrders.size() + 1
        && nextOrders.hasAll(oldOrders)
        && newOrder is map
        && newOrder.id is string
        && menuId is string
        && menuId.size() > 0
        && exists(menuPath)
        && menu.available == true
        && menu.price is number
        && menu.price >= 0
        && newOrder.name == menu.name
        && newOrder.price == menu.price
        && newOrder.category == menu.category
        && newOrder.quantity is int
        && newOrder.quantity > 0
        && newOrder.quantity <= 100
        && newOrder.addedAt is string
        && nextSession.foodTotal is number
        && nextSession.foodTotal == previousSession.get('foodTotal', 0) + menu.price * newOrder.quantity;
    }

    function workerTableUpdate(clubId, tableId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let previousSession = resource.data.currentSession;
      let nextSession = request.resource.data.currentSession;
      let receiptId = request.resource.data.get('lastReceiptId', '_invalid');
      let receiptPath = /databases/$(database)/documents/clubs/$(clubId)/history/$(receiptId);
      return activeStaff(clubId)
        && userProfile().role == 'worker'
        && changed.hasOnly(['status', 'currentSession', 'lastReceiptId'])
        && (
          resource.data.status == 'available'
            && request.resource.data.status == 'occupied'
            && nextSession is map
            && nextSession.hourlyRate == resource.data.hourlyRate
            && nextSession.startTime >= request.time.toMillis() - 120000
            && nextSession.startTime <= request.time.toMillis() + 60000
            && nextSession.totalPausedSeconds == 0
            && nextSession.isPaused == false
            && nextSession.foodOrders is list
            && nextSession.foodOrders.size() == 0
            && nextSession.get('foodTotal', 0) == 0
          || resource.data.status == 'occupied'
            && request.resource.data.status == 'occupied'
            && previousSession is map
            && nextSession is map
            && nextSession.hourlyRate == previousSession.hourlyRate
            && nextSession.startTime == previousSession.startTime
            && nextSession.totalPausedSeconds == previousSession.totalPausedSeconds
            && nextSession.diff(previousSession).affectedKeys().hasOnly(['foodOrders', 'foodTotal'])
            && validWorkerFoodOrder(clubId, previousSession, nextSession)
          || resource.data.status == 'occupied'
            && request.resource.data.status == 'occupied'
            && previousSession is map
            && nextSession is map
            && nextSession.hourlyRate == previousSession.hourlyRate
            && nextSession.startTime == previousSession.startTime
            && previousSession.isPaused == false
            && nextSession.isPaused == true
            && nextSession.pausedAt is number
            && nextSession.pausedAt >= request.time.toMillis() - 60000
            && nextSession.pausedAt <= request.time.toMillis() + 60000
            && nextSession.totalPausedSeconds == previousSession.totalPausedSeconds
            && nextSession.diff(previousSession).affectedKeys().hasOnly(['isPaused', 'pausedAt'])
          || resource.data.status == 'occupied'
            && request.resource.data.status == 'occupied'
            && previousSession is map
            && nextSession is map
            && nextSession.hourlyRate == previousSession.hourlyRate
            && nextSession.startTime == previousSession.startTime
            && previousSession.isPaused == true
            && nextSession.isPaused == false
            && previousSession.pausedAt is number
            && nextSession.get('pausedAt', null) == null
            && math.abs(nextSession.totalPausedSeconds - previousSession.totalPausedSeconds
              - math.floor((request.time.toMillis() - previousSession.pausedAt) / 1000)) <= 60
            && nextSession.diff(previousSession).affectedKeys().hasOnly(['isPaused', 'pausedAt', 'totalPausedSeconds'])
          || resource.data.status == 'occupied'
            && request.resource.data.status == 'payment_pending'
            && nextSession == previousSession
            && changed.hasOnly(['status'])
          || resource.data.status in ['occupied', 'payment_pending']
            && request.resource.data.status == 'available'
            && nextSession == null
            && receiptId is string
            && existsAfter(receiptPath)
            && getAfter(receiptPath).data.tableId == tableId
            && getAfter(receiptPath).data.processedBy == request.auth.token.email
            && changed.hasOnly(['status', 'currentSession', 'lastReceiptId'])
        );
    }

    function workerBillCustomerUpdate(clubId, customerId) {
      let receiptId = request.resource.data.get('lastReceiptId', '_invalid');
      let receiptPath = /databases/$(database)/documents/clubs/$(clubId)/history/$(receiptId);
      let receipt = getAfter(receiptPath).data;
      let splitData = receipt.get('splitBreakdown', {});
      let splitType = splitData is map ? splitData.get('splitType', 'method') : 'method';
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return activeStaff(clubId)
        && userProfile().role == 'worker'
        && receiptId is string
        && existsAfter(receiptPath)
        && receipt.id == receiptId
        && receipt.customerId == customerId
        && receipt.customerIds is list
        && receipt.customerIds.size() == 1
        && receipt.customerIds[0] == customerId
        && splitType != 'players'
        && receipt.processedBy == request.auth.token.email
        && receipt.amountPaid is number && receipt.amountPaid >= 0
        && receipt.balanceDue is number && receipt.balanceDue >= 0
        && receipt.durationSeconds is number && receipt.durationSeconds >= 0
        && changed.hasOnly(['totalSpent', 'sessionsCount', 'totalHoursPlayed', 'outstandingDue', 'lastVisit', 'lastReceiptId', 'udhaarLedger'])
        && request.resource.data.get('totalSpent', 0) == resource.data.get('totalSpent', 0) + receipt.amountPaid
        && request.resource.data.get('sessionsCount', 0) == resource.data.get('sessionsCount', 0) + 1
        && request.resource.data.get('totalHoursPlayed', 0) == resource.data.get('totalHoursPlayed', 0) + receipt.durationSeconds / 3600
        && request.resource.data.get('outstandingDue', 0) == resource.data.get('outstandingDue', 0) + receipt.balanceDue
        && request.resource.data.lastReceiptId == receiptId
        && request.resource.data.lastVisit is string
        && validWorkerBillLedger(receiptId, customerId, receipt);
    }

    function validWorkerBillLedger(receiptId, customerId, receipt) {
      let oldLedger = resource.data.get('udhaarLedger', []);
      let nextLedger = request.resource.data.get('udhaarLedger', oldLedger);
      let paidEntry = {
        'id': receiptId + '-payment-' + customerId,
        'timestamp': receipt.endTime,
        'type': 'payment_received',
        'amount': receipt.amountPaid,
        'description': 'Payment received for receipt #' + receipt.receiptNo,
        'receiptNo': receipt.receiptNo,
        'receiptId': receiptId,
        'paymentMethod': receipt.paymentMethod,
        'source': 'bill',
        'customerId': customerId,
        'recordedByEmail': request.auth.token.email,
        'recordedBy': request.auth.token.email
      };
      let dueEntry = {
        'id': receiptId + '-due-' + customerId,
        'timestamp': receipt.endTime,
        'type': 'due_added',
        'amount': receipt.balanceDue,
        'description': 'Amount due for receipt #' + receipt.receiptNo,
        'receiptNo': receipt.receiptNo,
        'receiptId': receiptId,
        'source': 'bill',
        'customerId': customerId,
        'recordedByEmail': request.auth.token.email,
        'recordedBy': request.auth.token.email
      };
      let expectedLedgerEntries = (receipt.amountPaid > 0 ? 1 : 0) + (receipt.balanceDue > 0 ? 1 : 0);
      return oldLedger is list && nextLedger is list
        && nextLedger.hasAll(oldLedger)
        && nextLedger.size() == oldLedger.size() + expectedLedgerEntries
        && (receipt.amountPaid == 0 || nextLedger.hasAny([paidEntry]))
        && (receipt.balanceDue == 0 || nextLedger.hasAny([dueEntry]));
    }

    function workerAccountCustomerUpdate(clubId, customerId) {
      let transactionId = request.resource.data.lastAccountTransactionId;
      let transactionPath = /databases/$(database)/documents/clubs/$(clubId)/customers/$(customerId)/transactions/$(transactionId);
      let entry = getAfter(transactionPath).data;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return activeStaff(clubId)
        && userProfile().role == 'worker'
        && transactionId is string
        && existsAfter(transactionPath)
        && entry.customerId == customerId
        && entry.recordedByEmail == request.auth.token.email
        && entry.amount is number && entry.amount > 0
        && changed.hasOnly(['outstandingDue', 'totalSpent', 'walletBalance', 'udhaarLedger', 'lastAccountTransactionId', 'updatedAt'])
        && (entry.type == 'payment_received'
          && entry.source == 'balance_settlement'
          && resource.data.outstandingDue >= entry.amount
          && request.resource.data.outstandingDue == resource.data.outstandingDue - entry.amount
          && request.resource.data.totalSpent == resource.data.totalSpent + entry.amount
          && request.resource.data.walletBalance == resource.data.walletBalance
          || entry.type == 'deposit_added'
          && request.resource.data.walletBalance == resource.data.walletBalance + entry.amount
          && request.resource.data.outstandingDue == resource.data.outstandingDue
          && request.resource.data.totalSpent == resource.data.totalSpent);
    }

    function workerPortalBillUpdate(clubId, customerId) {
      let customerPath = /databases/$(database)/documents/clubs/$(clubId)/customers/$(customerId);
      let customerAfter = getAfter(customerPath).data;
      let receiptId = customerAfter.get('lastReceiptId', '_invalid');
      let receiptPath = /databases/$(database)/documents/clubs/$(clubId)/history/$(receiptId);
      return activeStaff(clubId)
        && userProfile().role == 'worker'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sessionsCount', 'totalSpent', 'totalHoursPlayed', 'outstandingDue', 'lastVisit', 'lastReceiptId'])
        && existsAfter(receiptPath)
        && getAfter(receiptPath).data.customerIds.hasAny([customerId])
        && request.resource.data.lastReceiptId == customerAfter.lastReceiptId
        && request.resource.data.sessionsCount == customerAfter.sessionsCount
        && request.resource.data.totalSpent == customerAfter.totalSpent
        && request.resource.data.totalHoursPlayed == customerAfter.totalHoursPlayed
        && request.resource.data.outstandingDue == customerAfter.outstandingDue
        && request.resource.data.lastVisit == customerAfter.lastVisit;
    }

    function workerPortalAccountUpdate(clubId, customerId) {
      let customerPath = /databases/$(database)/documents/clubs/$(clubId)/customers/$(customerId);
      let customerAfter = getAfter(customerPath).data;
      let transactionId = customerAfter.get('lastAccountTransactionId', '_invalid');
      let transactionPath = /databases/$(database)/documents/clubs/$(clubId)/customers/$(customerId)/transactions/$(transactionId);
      return activeStaff(clubId)
        && userProfile().role == 'worker'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outstandingDue', 'totalSpent', 'walletBalance'])
        && existsAfter(transactionPath)
        && request.resource.data.outstandingDue == customerAfter.outstandingDue
        && request.resource.data.totalSpent == customerAfter.totalSpent
        && request.resource.data.walletBalance == customerAfter.walletBalance;
    }

    match /users/{userId} {
      allow get: if signedIn() && (
        request.auth.uid == userId ||
        (hasUserProfile() && userProfile().role in ['owner', 'manager'] && userProfile().status == 'active')
      );
      allow list: if hasUserProfile() && userProfile().role in ['owner', 'manager'] && userProfile().status == 'active';
      // The first owner is provisioned manually. Staff can only accept a manager/worker invitation.
      allow create: if signedIn() && userId == request.auth.uid && validStaffInvite(userId)
        || signedIn() && validCustomerAccount(userId);
      allow update: if signedIn() && userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin', 'lastLoginAt', 'updatedAt'])
        || hasUserProfile() && userProfile().role == 'owner'
        && userProfile().clubId == resource.data.clubId
        && request.resource.data.clubId == resource.data.clubId
        && request.resource.data.role in ['manager', 'worker', 'customer'];
      allow delete: if owner(resource.data.clubId);
    }

    match /invitations/{invitationId} {
      allow get: if signedIn() && (
        (request.auth.token.email == resource.data.email && resource.data.status == 'pending') ||
        managerOrOwner(resource.data.clubId)
      );
      allow list: if hasUserProfile() && userProfile().role in ['owner', 'manager'] && userProfile().status == 'active';
      allow create: if managerOrOwner(request.resource.data.clubId)
        && request.resource.data.email is string
        && request.resource.data.email == invitationId
        && request.resource.data.role in ['manager', 'worker']
        && request.resource.data.status == 'pending';
      allow update: if managerOrOwner(resource.data.clubId)
        || signedIn()
          && request.auth.token.email == resource.data.email
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'acceptedByUid'])
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedByUid == request.auth.uid
          && getAfter(userPath(request.auth.uid)).data.role == resource.data.role
          && getAfter(userPath(request.auth.uid)).data.invitationCode == resource.data.code;
      allow delete: if managerOrOwner(resource.data.clubId);
    }

    match /clubs/{clubId} {
      allow read: if activeStaff(clubId);
      allow write: if owner(clubId);

      match /config/{docId} {
        allow read: if activeStaff(clubId);
        allow write: if owner(clubId);
      }

      match /tables/{tableId} {
        allow read: if activeStaff(clubId);
        allow create, delete: if managerOrOwner(clubId);
        allow update: if managerOrOwner(clubId) || workerTableUpdate(clubId, tableId);
      }

      match /menuItems/{itemId} {
        allow read: if activeStaff(clubId);
        allow write: if managerOrOwner(clubId);
      }

      match /foodOrders/{orderId} {
        allow read, write: if activeStaff(clubId);
      }

      match /requests/{requestId} {
        allow read, write: if activeStaff(clubId);
      }

      match /purchaseRecords/{purchaseId} {
        allow read, write: if managerOrOwner(clubId);
      }

      match /inventoryAdjustments/{adjustmentId} {
        allow read, write: if managerOrOwner(clubId);
      }

      match /customers/{customerId} {
        allow read: if activeStaff(clubId);
        allow create: if managerOrOwner(clubId)
          || activeStaff(clubId)
            && userProfile().role == 'worker'
            && request.resource.data.email == ''
            && request.resource.data.outstandingDue == 0
            && request.resource.data.walletBalance == 0
            && request.resource.data.totalSpent == 0
            && request.resource.data.sessionsCount == 0;
        allow update: if managerOrOwner(clubId)
          || activeStaff(clubId)
            && userProfile().role == 'worker'
            && request.resource.data.email == resource.data.email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'preferredGame', 'notes', 'updatedAt', 'customerNumber', 'id', 'dateJoined'])
          || workerBillCustomerUpdate(clubId, customerId)
          || workerAccountCustomerUpdate(clubId, customerId);
        allow delete: if false;

        match /transactions/{transactionId} {
          allow read: if activeStaff(clubId);
          allow create: if managerOrOwner(clubId)
            && request.resource.data.customerId == customerId
            && request.resource.data.clubId == clubId
            && request.resource.data.amount is number
            && request.resource.data.amount > 0
            || activeStaff(clubId)
              && userProfile().role == 'worker'
              && request.resource.data.customerId == customerId
              && request.resource.data.clubId == clubId
              && request.resource.data.recordedByEmail == request.auth.token.email
              && request.resource.data.amount is number
              && request.resource.data.amount > 0
              && request.resource.data.type in ['payment_received', 'deposit_added'];
          allow update, delete: if false;
        }
      }

      match /customerAccess/{email} {
        allow get: if activeStaff(clubId)
          || signedIn() && request.auth.token.email_verified == true && request.auth.token.email == email;
        allow list: if managerOrOwner(clubId);
        allow create, update: if managerOrOwner(clubId)
          && request.resource.data.clubId == clubId
          && request.resource.data.email == email
          && request.resource.data.customerId is string
          && request.resource.data.enabled is bool;
        allow delete: if managerOrOwner(clubId);
      }

      match /customerPortal/{customerId} {
        allow get: if activeStaff(clubId) || customerOwns(clubId, customerId);
        allow list: if managerOrOwner(clubId);
        allow create: if managerOrOwner(clubId);
        allow update: if managerOrOwner(clubId)
          || activeStaff(clubId)
            && userProfile().role == 'worker'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && request.resource.data.name == getAfter(/databases/$(database)/documents/clubs/$(clubId)/customers/$(customerId)).data.name
          || workerPortalBillUpdate(clubId, customerId)
          || workerPortalAccountUpdate(clubId, customerId);
        allow delete: if managerOrOwner(clubId);

        match /receipts/{receiptId} {
          allow read: if activeStaff(clubId) || customerOwns(clubId, customerId);
          allow create: if activeStaff(clubId)
            && existsAfter(/databases/$(database)/documents/clubs/$(clubId)/history/$(receiptId))
            && getAfter(/databases/$(database)/documents/clubs/$(clubId)/history/$(receiptId)).data.customerIds.hasAny([customerId]);
          allow update: if owner(clubId)
            || managerOrOwner(clubId)
              && resource.data.customerId == customerId
              && request.resource.data.paymentStatus == 'refunded'
              && existsAfter(/databases/$(database)/documents/clubs/$(clubId)/history/$(receiptId))
              && getAfter(/databases/$(database)/documents/clubs/$(clubId)/history/$(receiptId)).data.paymentStatus == 'refunded'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'refundedAmount', 'refundReason']);
          allow delete: if managerOrOwner(clubId);
        }

        match /activity/{activityId} {
          allow read: if activeStaff(clubId) || customerOwns(clubId, customerId);
          allow create: if managerOrOwner(clubId)
            || activeStaff(clubId)
              && request.resource.data.recordedByEmail == request.auth.token.email
              && (existsAfter(/databases/$(database)/documents/clubs/$(clubId)/customers/$(customerId)/transactions/$(activityId))
                && getAfter(/databases/$(database)/documents/clubs/$(clubId)/customers/$(customerId)/transactions/$(activityId)).data.recordedByEmail == request.auth.token.email
                || request.resource.data.receiptId is string
                  && existsAfter(/databases/$(database)/documents/clubs/$(clubId)/history/$(request.resource.data.receiptId))
                  && getAfter(/databases/$(database)/documents/clubs/$(clubId)/history/$(request.resource.data.receiptId)).data.customerIds.hasAny([customerId])
                  && getAfter(/databases/$(database)/documents/clubs/$(clubId)/history/$(request.resource.data.receiptId)).data.processedBy == request.auth.token.email);
          allow update, delete: if false;
        }
      }

      match /history/{historyId} {
        allow read: if activeStaff(clubId);
        allow create: if validCheckout(clubId);
        allow update: if owner(clubId)
          || managerOrOwner(clubId)
            && resource.data.paymentStatus != 'refunded'
            && request.resource.data.paymentStatus == 'refunded'
            && request.resource.data.refundReason is string
            && request.resource.data.refundReason.size() > 0
            && request.resource.data.refundedBy == request.auth.token.email
            && request.resource.data.refundedAmount == resource.data.amountPaid
            && request.resource.data.refundedAt is number
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'refundReason', 'refundedBy', 'refundedAt', 'refundedAmount']);
        allow delete: if owner(clubId);
      }

      match /employees/{employeeId} {
        allow read: if activeStaff(clubId);
        allow write: if owner(clubId);
      }

      match /expenses/{expenseId} {
        allow read, write: if managerOrOwner(clubId);
      }

      match /maintenance/{maintenanceId} {
        allow read, write: if activeStaff(clubId);
      }

      match /notifications/{notificationId} {
        allow read, write: if activeStaff(clubId);
      }

      match /auditLogs/{logId} {
        allow read: if managerOrOwner(clubId);
        allow create: if activeStaff(clubId)
          && request.resource.data.clubId == clubId
          && request.resource.data.performedBy == request.auth.token.email;
        allow update, delete: if false;
      }
    }

    // Vercel is the deployment target; platform/SaaS collections are intentionally closed
    // for this single local-club installation.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
